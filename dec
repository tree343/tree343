---------------------------------------------------------------------------------
import os

# note for several run IDs we do not use --compute-image-metrics or --decoder 
# RUN_IDS = [10, 11, 12, 13, 14, 15, 16, 17]
RUN_IDS = [10] # change for specific run ID

# Experiments with different episode, start frame, target frame
EXPERIMENT_RUNS = {
    "experiment_1": [0, 2, 902],
    "experiment_2": [1, 10, 910],
    "experiment_3": [4, 1010, 1910],
    "experiment_4": [8, 130, 730],
    "experiment_5": [8, 100, 700],
    "experiment_6": [9, 100, 400],
    "experiment_7": [0, 540, 840],
    "experiment_8": [2, 600, 700],
    "experiment_9": [6, 5, 105],
}

# Define your static parameters
GAME_NAME = "mkdd"
H5_FILENAME = "mkdd_plan_test"
CKPT_NUM = 75
EPISODE = 0
NUM_PLANNING_HORIZON_STEPS = 20
NUM_CANDIDATE_ACTION_SEQENCES = 300
TOP_CANDIDATE_ACTION_SEQENCES = 30
NUM_CEM_ITERATIONS = 100
REPLAN_INTERVAL = 5
REPEAT = 5
SEED = 37

# Define STABLEWM_HOME if it's not already in your environment variables
STABLEWM_HOME = os.environ.get("STABLEWM_HOME", "./")
HDF5_SOURCE_DATA = os.path.join(STABLEWM_HOME, GAME_NAME, f"{H5_FILENAME}.h5")

# Loop over each RUN_ID
for run_id in RUN_IDS:

    run_name = f"run_{run_id}"
    checkpoint = f"../runs/{GAME_NAME}/{run_name}/ckpts/lewm_epoch_{CKPT_NUM}_object.ckpt"

    # Loop over each experiment setup
    for exp_name, (episode, start_frame, target_frame) in EXPERIMENT_RUNS.items():

        print(f"=== Starting {run_name} | {exp_name}: frames {start_frame} to {target_frame} ===")

        # Construct the bash command
        cmd = f"""python plan_latent.py \
            --checkpoint {checkpoint} \
            --dataset {HDF5_SOURCE_DATA} \
            --episode {episode} \
            --start-frame {start_frame} \
            --target-frame {target_frame} \
            --num-planning-horizon-steps {NUM_PLANNING_HORIZON_STEPS} \
            --num-candidate-action-sequences {NUM_CANDIDATE_ACTION_SEQENCES} \
            --topk {TOP_CANDIDATE_ACTION_SEQENCES} \
            --num-cem-iterations {NUM_CEM_ITERATIONS} \
            --mpc latent \
            --replan-interval {REPLAN_INTERVAL} \
			--decoder ../runs/mkdd/run_{run_id}/training_decoder_only_summary/75_ckpt_trained_decoder_only/decoder_final.ckpt \
			--compute-image-metrics \
            --repeat {REPEAT} \
            --seed {SEED}
            """

        # Execute the command in the notebook shell
        !{cmd}






ACTION_NAMES = {
    0: "Idle",
    1: "LEFT",
    2: "RIGHT",
    4: "A (Jump)",
    5: "LEFT + A",
    6: "RIGHT + A",
    8: "S (Run/Fire)",
    9: "LEFT + S",
    10: "RIGHT + S",
    12: "A + S",
    13: "LEFT + A + S",
    14: "RIGHT + A + S",
    16: "DOWN",
    17: "LEFT + DOWN",
    18: "RIGHT + DOWN",
    20: "A + DOWN",
    21: "LEFT + A + DOWN",
    22: "RIGHT + A + DOWN",
    24: "S + DOWN",
    25: "LEFT + S + DOWN",
    26: "RIGHT + S + DOWN",
    28: "JUMP + S + DOWN",
    29: "LEFT + A + S + DOWN",
    30: "RIGHT + A + S + DOWN",
}


def compute_stats(trajectories):
    """Compute dataset statistics from discovered trajectories."""
    num_episodes = len(trajectories)
    lengths = [len(t["frames"]) for t in trajectories]
    total_frames = sum(lengths)
    lengths_arr = np.array(lengths)

    # Action distribution (across all frames)
    action_counter = Counter()
    for t in trajectories:
        for _, _, action_code, _ in t["frames"]:
            action_counter[action_code] += 1

    # Last-frame alive/dead per trajectory
    alive_count = 0
    dead_count = 0
    for t in trajectories:
        last_alive = t["frames"][-1][3]  # alive flag of last frame
        if last_alive == 1:
            alive_count += 1
        else:
            dead_count += 1

    # Per-player counts
    player_counter = defaultdict(int)
    for t in trajectories:
        # Extract player prefix from directory name (e.g., "feiyan" from "feiyan23")
        name = t["name"]
        player = re.sub(r"\d+$", "", name)
        player_counter[player] += 1

    stats = {
        "num_episodes": num_episodes,
        "total_frames": total_frames,
        "len_min": int(lengths_arr.min()),
        "len_max": int(lengths_arr.max()),
        "len_mean": float(lengths_arr.mean()),
        "len_median": float(np.median(lengths_arr)),
        "len_std": float(lengths_arr.std()),
        "action_counter": dict(action_counter),
        "alive_at_end": alive_count,
        "dead_at_end": dead_count,
        "player_counter": dict(player_counter),
    }
    return stats


def generate_mario_data_md(stats, output_path: str):
    """Write mario_data.md with original README info + computed statistics."""
    lines = []

    # Reproduce original README content
    lines.append(README_CONTENT.strip())
    lines.append("")
    lines.append("---")
    lines.append("")

    # Dataset statistics section
    lines.append("# Computed Dataset Statistics")
    lines.append("")
    lines.append("The statistics below were computed by `convert_mario_to_hdf5.py` ")
    lines.append("during the conversion to HDF5 format.")
    lines.append("")

    # Summary table
    lines.append("## Summary")
    lines.append("")
    lines.append("| Metric | Value |")
    lines.append("|--------|-------|")
    lines.append(f"| Trajectories (episodes) | **{stats['num_episodes']}** |")
    lines.append(f"| Total frames | **{stats['total_frames']:,}** |")
    lines.append(f"| Stored image size | 224 x 224 x 3 (resized from 800x600) |")
    lines.append(f"| Action encoding | One-hot (dim=31, codes 0-30) |")
    lines.append("")

    # Trajectory length distribution
    lines.append("## Trajectory Length Distribution")
    lines.append("")
    lines.append("| Statistic | Value |")
    lines.append("|-----------|-------|")
    lines.append(f"| Min | {stats['len_min']} |")
    lines.append(f"| Max | {stats['len_max']} |")
    lines.append(f"| Mean | {stats['len_mean']:.1f} |")
    lines.append(f"| Median | {stats['len_median']:.1f} |")
    lines.append(f"| Std | {stats['len_std']:.1f} |")
    lines.append("")

    # Alive / Dead at end of trajectory
    lines.append("## Trajectory Outcome (Last Frame)")
    lines.append("")
    lines.append("| Status | Count | Percentage |")
    lines.append("|--------|-------|------------|")
    total_ep = stats["num_episodes"]
    alive_pct = 100.0 * stats["alive_at_end"] / total_ep if total_ep else 0
    dead_pct = 100.0 * stats["dead_at_end"] / total_ep if total_ep else 0
    lines.append(
        f"| Alive (nt1) | {stats['alive_at_end']} | {alive_pct:.1f}% |"
    )
    lines.append(
        f"| Dead (nt0) | {stats['dead_at_end']} | {dead_pct:.1f}% |"
    )
    lines.append("")

    # Action distribution
    lines.append("## Action Distribution")
    lines.append("")
    lines.append("| Code | Action | Count | Percentage |")
    lines.append("|------|--------|-------|------------|")
    total_act = stats["total_frames"]
    for code in sorted(stats["action_counter"].keys()):
        count = stats["action_counter"][code]
        pct = 100.0 * count / total_act if total_act else 0
        name = ACTION_NAMES.get(code, f"Unknown({code})")
        lines.append(f"| {code} | {name} | {count:,} | {pct:.2f}% |")
    lines.append("")

    # Per-player trajectory counts
    lines.append("## Trajectories per Player")
    lines.append("")
    lines.append("| Player | Trajectories |")
    lines.append("|--------|--------------|")
    for player in sorted(stats["player_counter"].keys()):
        lines.append(f"| {player} | {stats['player_counter'][player]} |")
    lines.append("")

    # HDF5 schema documentation
    lines.append("---")
    lines.append("")
    lines.append("# HDF5 Output Schema")
    lines.append("")
    lines.append(
        "The `.h5` file is compatible with `stable_worldmodel.data.HDF5Dataset` "
        "(used by LeWM `train.py`)."
    )
    lines.append("")
    lines.append("| Dataset | Shape | Dtype | Description |")
    lines.append("|---------|-------|-------|-------------|")
    lines.append(
        f"| `pixels` | [{stats['total_frames']}, 224, 224, 3] | uint8 | "
        "RGB frames resized from 800x600 via Lanczos |"
    )
    lines.append(
        f"| `action` | [{stats['total_frames']}, 31] | float32 | "
        "One-hot encoded action (codes 0-30) |"
    )
    lines.append(
        f"| `episode_idx` | [{stats['total_frames']}] | int32 | "
        "Which episode each frame belongs to |"
    )
    lines.append(
        f"| `step_idx` | [{stats['total_frames']}] | int32 | "
        "Timestep within the episode |"
    )
    lines.append(
        f"| `alive` | [{stats['total_frames']}] | int32 | "
        "1 = Mario alive, 0 = Mario dead |"
    )
    lines.append(
        f"| `ep_len` | [{stats['num_episodes']}] | int32 | "
        "Length of each episode |"
    )
    lines.append(
        f"| `ep_offset` | [{stats['num_episodes']}] | int32 | "
        "Start index of each episode in the flat arrays |"
    )
    lines.append("")

    lines.append("## Notes")
    lines.append("")
    lines.append(
        "- Images are resized from the original 800x600 to 224x224 using "
        "Lanczos resampling to match LeWM's expected input resolution."
    )
    lines.append(
        "- Actions are one-hot encoded into a 31-dimensional vector (indices 0-30). "
        "Not all codes are used by the game; unused indices will be all-zeros."
    )
    lines.append(
        "- The `alive` column is **not** consumed by LeWM training but is preserved "
        "as metadata. The last frame of each trajectory indicates whether Mario "
        "survived (`nt1`) or died (`nt0`)."
    )
    lines.append("")

    md_text = "\n".join(lines)

    with open(output_path, "w") as f:
        f.write(md_text)

    print(f"Wrote documentation to {output_path}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        description="Convert Mario PNG dataset to LeWM-compatible HDF5"
    )
    parser.add_argument(
        "--data-dir",
        default=os.path.join(os.path.dirname(__file__), "mariodata"),
        help="Root directory containing per-trajectory subdirectories of PNGs",
    )
    parser.add_argument(
        "--output",
        default=None,
        help="Output HDF5 file path (default: <data-dir>/../mario.h5)",
    )
    parser.add_argument(
        "--md-output",
        default=None,
        help="Output markdown file path (default: <data-dir>/../mario_data.md)",
    )
    parser.add_argument(
        "--stats-only",
        action="store_true",
        help="Only compute and print stats, do not write HDF5",
    )
    args = parser.parse_args()

    data_dir = args.data_dir
    if args.output is None:
        args.output = os.path.join(os.path.dirname(data_dir), "mario.h5")
    if args.md_output is None:
        args.md_output = os.path.join(os.path.dirname(data_dir), "mario_data.md")

    print(f"Scanning trajectories in {data_dir} ...")
    trajectories = discover_trajectories(data_dir)

    if not trajectories:
        print("ERROR: No trajectories found. Check --data-dir path.", file=sys.stderr)
        sys.exit(1)

    print(f"Found {len(trajectories)} trajectories")

    # Compute statistics
    stats = compute_stats(trajectories)

    # Print summary to console
    print(f"\n{'='*50}")
    print(f"  Trajectories:  {stats['num_episodes']}")
    print(f"  Total frames:  {stats['total_frames']:,}")
    print(f"  Length range:  {stats['len_min']} – {stats['len_max']}")
    print(f"  Length mean:   {stats['len_mean']:.1f} (std {stats['len_std']:.1f})")
    print(f"  Alive at end:  {stats['alive_at_end']}")
    print(f"  Dead at end:   {stats['dead_at_end']}")
    print(f"{'='*50}\n")

    # Generate markdown report
    generate_mario_data_md(stats, args.md_output)

    if args.stats_only:
        print("Stats-only mode: skipping HDF5 generation.")
        return

    # Write HDF5
    write_hdf5(trajectories, args.output)

    print("\nAll done!")
    print(f"  HDF5:     {args.output}")
    print(f"  Markdown: {args.md_output}")


if __name__ == "__main__":
    main()









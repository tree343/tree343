#!/usr/bin/env python3
"""Convert the Mario Gameplay Dataset (PNG per frame) to a LeWM-compatible HDF5 file.

Each subdirectory under the data root is treated as one trajectory (episode).
Filenames follow: {user}_f{frame_id}_a{action_code}_nt{death_status}.png

Output HDF5 layout (stable_worldmodel.data.HDF5Dataset compatible):
    pixels:      [total_frames, 224, 224, 3] uint8
    action:      [total_frames, 31]           float32  (one-hot, codes 0-30)
    episode_idx: [total_frames]               int32
    step_idx:    [total_frames]               int32
    ep_len:      [num_episodes]               int32
    ep_offset:   [num_episodes]               int32
    alive:       [total_frames]               int32    (1=alive, 0=dead)

Also generates mario_data.md with full dataset documentation and statistics.
"""

import argparse
import os
import re
import sys
import time
from collections import Counter, defaultdict
from pathlib import Path

import h5py
import numpy as np
from PIL import Image

# ---------------------------------------------------------------------------
# Filename parsing
# ---------------------------------------------------------------------------

FRAME_RE = re.compile(
    r"^(?P<user>[a-zA-Z]+)_f(?P<fid>\d+)_a(?P<action>\d+)_nt(?P<alive>[01])\.png$"
)

IMG_SIZE = 224
NUM_ACTIONS = 31  # action codes 0-30


def parse_filename(fname: str):
    """Return (user, frame_id, action_code, alive) or None if not matching."""
    m = FRAME_RE.match(fname)
    if m is None:
        return None
    return (
        m.group("user"),
        int(m.group("fid")),
        int(m.group("action")),
        int(m.group("alive")),
    )


# ---------------------------------------------------------------------------
# Trajectory discovery
# ---------------------------------------------------------------------------


def discover_trajectories(data_dir: str):
    """Walk subdirectories and return a sorted list of trajectory dicts.

    Each dict: {
        "name": str,          # subdirectory name
        "frames": [(path, frame_id, action_code, alive), ...],  # sorted by frame_id
    }
    """
    data_path = Path(data_dir)
    trajectories = []

    for subdir in sorted(data_path.iterdir()):
        if not subdir.is_dir():
            continue
        frames = []
        for f in subdir.iterdir():
            if not f.suffix.lower() == ".png":
                continue
            parsed = parse_filename(f.name)
            if parsed is None:
                continue
            _user, fid, action, alive = parsed
            frames.append((str(f), fid, action, alive))
        if not frames:
            continue
        # Sort by frame_id
        frames.sort(key=lambda x: x[1])
        trajectories.append({"name": subdir.name, "frames": frames})

    return trajectories


# ---------------------------------------------------------------------------
# HDF5 writing
# ---------------------------------------------------------------------------


def write_hdf5(trajectories, output_path: str):
    """Write all trajectories to HDF5."""

    total_frames = sum(len(t["frames"]) for t in trajectories)
    num_episodes = len(trajectories)

    print(f"Writing HDF5: {num_episodes} episodes, {total_frames} total frames")
    print(f"Output: {output_path}")

    ep_lengths = np.array([len(t["frames"]) for t in trajectories], dtype=np.int32)
    ep_offsets = np.concatenate(([0], np.cumsum(ep_lengths[:-1]))).astype(np.int32)

    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)

    with h5py.File(output_path, "w") as hf:
        px = hf.create_dataset(
            "pixels", shape=(total_frames, IMG_SIZE, IMG_SIZE, 3), dtype=np.uint8
        )
        act = hf.create_dataset(
            "action", shape=(total_frames, NUM_ACTIONS), dtype=np.float32
        )
        ep_idx = hf.create_dataset("episode_idx", shape=(total_frames,), dtype=np.int32)
        st_idx = hf.create_dataset("step_idx", shape=(total_frames,), dtype=np.int32)
        alive_ds = hf.create_dataset("alive", shape=(total_frames,), dtype=np.int32)
        hf.create_dataset("ep_len", data=ep_lengths, dtype=np.int32)
        hf.create_dataset("ep_offset", data=ep_offsets, dtype=np.int32)

        offset = 0
        t0 = time.time()
        for ep_i, traj in enumerate(trajectories):
            n = len(traj["frames"])
            for j, (img_path, _fid, action_code, alive_flag) in enumerate(
                traj["frames"]
            ):
                idx = offset + j

                # Load and resize image
                img = Image.open(img_path).convert("RGB")
                img = img.resize((IMG_SIZE, IMG_SIZE), Image.LANCZOS)
                px[idx] = np.array(img, dtype=np.uint8)

                # One-hot action
                one_hot = np.zeros(NUM_ACTIONS, dtype=np.float32)
                if 0 <= action_code < NUM_ACTIONS:
                    one_hot[action_code] = 1.0
                act[idx] = one_hot

                ep_idx[idx] = ep_i
                st_idx[idx] = j
                alive_ds[idx] = alive_flag

            offset += n

            if (ep_i + 1) % 10 == 0 or ep_i == num_episodes - 1:
                elapsed = time.time() - t0
                print(
                    f"  [{ep_i + 1}/{num_episodes}] "
                    f"{offset}/{total_frames} frames  ({elapsed:.1f}s)"
                )

    size_mb = os.path.getsize(output_path) / 1e6
    print(f"Done. HDF5 file: {size_mb:.1f} MB")


